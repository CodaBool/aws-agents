# every boot: secrets from SSM into ec2-user's quadlet env file, then restart what uses them
# fails outside EC2 (`just vm`), there is no instance role there
[Unit]
Description=Fetch agent secrets from SSM
Wants=network-online.target
After=network-online.target agent-quadlets-clone.service user@1000.service

[Service]
Type=oneshot
User=ec2-user
Environment=AWS_REGION=us-east-1
ExecStart=/usr/libexec/agent-secrets
# + runs as root, - because the tunnel quadlet may not exist yet
ExecStartPost=-+/usr/bin/systemctl --user -M ec2-user@ restart tunnel.service

[Install]
WantedBy=multi-user.target
