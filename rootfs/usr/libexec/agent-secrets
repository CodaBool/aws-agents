#!/usr/bin/bash
# writes SSM /agents/env (KEY=value lines, main.tf) as the quadlets' env file, mode 600
# SSM is the source of truth: the whole file is replaced on every run
# credentials come from the instance role through IMDS, so this only works on EC2
set -euo pipefail
param=/agents/env
file=$HOME/src/agent/quadlets/.env

# created by agent-quadlets-clone.service, don't create it here or the clone is skipped
[ -d "$(dirname "$file")" ] || { echo "no $(dirname "$file"), did the clone fail?"; exit 1; }

# the network can be up before IMDS answers
for i in 1 2 3 4 5; do
  env=$(aws ssm get-parameter --name "$param" --with-decryption --query Parameter.Value --output text) && break
  [ "$i" = 5 ] && exit 1
  sleep 10
done

# umask so the temp file is never readable by others, chmod in case umask is ignored
umask 077
printf '%s\n' "$env" > "$file.tmp"
chmod 600 "$file.tmp"
mv "$file.tmp" "$file"
echo "wrote $(grep -c '=' "$file") keys to $file: $(cut -d= -f1 "$file" | tr '\n' ' ')"
